CIRCLE_API_KEY=
CIRCLE_COMMUNITY_ID=
CIRCLE_API_BASE=https://app.circle.so/api/admin/v2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Circle member emails of the two clearly-labelled AI accounts (do not hard-code in git)
FINANCE_BOT_EMAIL=
PROCUREMENT_BOT_EMAIL=
# Secret for /run, /jobs, /drafts (send as header X-Run-Token)
RUN_TOKEN=
# Fixed space per desk (find IDs at /diag)
FINANCE_SPACE_ID=
PROCUREMENT_SPACE_ID=
# Optional fallback rotation if the two above are empty
POST_SPACE_IDS=
# false = save drafts only (check GET /drafts). Set true after Peter approves.
AUTO_POST=false
POST_DAYS=mon-fri
# Images: off | single | carousel
IMAGE_MODE=off
PUBLIC_URL=https://sbm-uk.onrender.com
IMAGE_DIR=data/img
