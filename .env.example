CIRCLE_API_KEY=
CIRCLE_COMMUNITY_ID=
CIRCLE_API_BASE=https://app.circle.so/api/v1
GROQ_API_KEY=
# Circle member emails of the two clearly-labelled AI accounts (do not hard-code in git)
FINANCE_BOT_EMAIL=
PROCUREMENT_BOT_EMAIL=
# Secret for /run, /jobs, /drafts (send as header X-Run-Token)
RUN_TOKEN=
# Comma-separated Circle space IDs the desks may post in (strongly recommended)
POST_SPACE_IDS=
# false = save drafts only (check GET /drafts). Set true after Peter approves.
AUTO_POST=false
POST_DAYS=mon-fri
